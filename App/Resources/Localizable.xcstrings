    "Or press %@ anywhere to dictate." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Или нажми %@ где угодно для диктовки." } } } },
    "Inserted into %@" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вставлено в %@" } } } },
    "Inserted" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вставлено" } } } },
    "Copied to clipboard — enable Accessibility to auto-insert" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировано в буфер — включи Универсальный доступ для авто-вставки" } } } },
    "RECENT" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "НЕДАВНЕЕ" } } } },
    "No transcriptions yet — press %@ and start talking." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока нет расшифровок — нажми %@ и начни говорить." } } } },
    "TRANSCRIBE FILES" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "РАСШИФРОВКА ФАЙЛОВ" } } } },
    "Drop audio files here" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перетащи сюда аудиофайлы" } } } },
    "Release to transcribe" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отпусти, чтобы расшифровать" } } } },
    "Queued" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "В очереди" } } } },
